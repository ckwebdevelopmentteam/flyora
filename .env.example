# ========================================================
# Flyora Monorepo Environment Variables
# ========================================================

# Neon PostgreSQL Database Connection
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Fastify API Server
PORT=5000
NODE_ENV=development
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-a-different-random-secret-at-least-32-characters"
# Cloudflare R2 Storage (Phase 2)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_PUBLIC_BUCKET="flyora-public"
R2_PRIVATE_BUCKET="flyora-private"
R2_PUBLIC_DOMAIN="https://media.flyora.com"

# Application URLs
NEXT_PUBLIC_API_URL="http://localhost:5000/api/v1"
ADMIN_APP_URL="http://localhost:3001"
WEB_APP_URL="http://localhost:3000"

# Development seed only; existing users are never reset.
ADMIN_BOOTSTRAP_PASSWORD=
DEMO_STAFF_PASSWORD=
