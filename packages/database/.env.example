# Copy to packages/database/.env for Prisma commands run in this workspace.
# Use the same database as apps/api/.env. Never commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Development seed only. Existing users are never reset.
# Set both to 16–72 byte passwords before explicitly running the seed command.
ADMIN_BOOTSTRAP_PASSWORD=
DEMO_STAFF_PASSWORD=

# Optional local Linux workaround if Neon IPv6 connections time out:
# RES_OPTIONS="no-aaaa"
