datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  OPERATIONS_MANAGER
  SERVICE_COORDINATOR
  CONTENT_MANAGER
  ACCOUNTS
}

enum StaffAvailability {
  AVAILABLE
  BUSY
  OFF_DUTY
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  fullName         String
  phone            String?
  role             UserRole          @default(SERVICE_COORDINATOR)
  availability     StaffAvailability @default(AVAILABLE)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  authSessions     AuthSession[]
  services         UserService[]
  assignedLeads    Lead[]            @relation("AssignedLeads")
  createdQuotes    Quotation[]
  recordedPayments Payment[]
  activities       LeadActivity[]
}

model Service {
  id               String        @id @default(uuid())
  name             String        @unique // e.g. "Holiday Packages", "Visa Assistance", "Flight Booking", "Umrah & Hajj", "Hotel Booking"
  slug             String        @unique
  description      String?
  isActive         Boolean       @default(true)
  minMarginPercent Float         @default(10.0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  coordinators     UserService[]
  packages         Package[]
  leads            Lead[]
}

model UserService {
  id        String   @id @default(uuid())
  userId    String
  serviceId String
  isPrimary Boolean  @default(true)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceId])
}

model Package {
  id               String    @id @default(uuid())
  serviceId        String
  title            String
  slug             String    @unique
  durationDays     Int
  durationNights   Int
  destination      String
  startingPrice    Decimal   @db.Decimal(10, 2)
  coverImageUrl    String
  galleryImageUrls String[]
  overview         String    @db.Text
  itinerary        Json      // Array of { day: number, title: string, description: string }
  inclusions       String[]
  exclusions       String[]
  isFeatured       Boolean   @default(false)
  isPublished      Boolean   @default(true)

  metaTitle        String?
  metaDescription  String?
  keywords         String[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  service          Service   @relation(fields: [serviceId], references: [id])
  leads            Lead[]
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  NEGOTIATING
  BOOKED
  LOST
}

enum LeadSource {
  WEBSITE_FORM
  WHATSAPP_CLICK
  PHONE_CALL
  DIRECT_WALK_IN
}

model Customer {
  id        String   @id @default(uuid())
  fullName  String
  phone     String   @unique
  email     String?
  city      String?
  createdAt DateTime @default(now())

  leads     Lead[]
}

model Lead {
  id              String         @id @default(uuid())
  customerId      String
  serviceId       String
  packageId       String?
  assignedToId    String?        // NULL = in Service Pool; Set = Claimed by Coordinator
  claimedAt       DateTime?
  status          LeadStatus     @default(NEW)
  source          LeadSource     @default(WEBSITE_FORM)
  customerNotes   String?        @db.Text
  travelDate      DateTime?
  numberOfAdults  Int            @default(1)
  numberOfKids    Int            @default(0)
  estimatedBudget Decimal?       @db.Decimal(10, 2)
  followUpDate    DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  customer        Customer       @relation(fields: [customerId], references: [id])
  service         Service        @relation(fields: [serviceId], references: [id])
  package         Package?       @relation(fields: [packageId], references: [id])
  assignedTo      User?          @relation("AssignedLeads", fields: [assignedToId], references: [id])
  activities      LeadActivity[]
  quotations      Quotation[]
  booking         Booking?
}

model LeadActivity {
  id        String   @id @default(uuid())
  leadId    String
  userId    String
  action    String   // "CLAIMED_LEAD", "STATUS_CHANGE", "NOTE_ADDED", "CALL_LOGGED", "FOLLOW_UP_SET"
  details   String   @db.Text
  createdAt DateTime @default(now())

  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quotation {
  id           String      @id @default(uuid())
  leadId       String
  createdById  String
  quoteNumber  String      @unique
  version      Int         @default(1)
  status       QuoteStatus @default(DRAFT)
  shareToken   String      @unique @default(uuid())

  supplierCost Decimal     @db.Decimal(10, 2)
  sellingPrice Decimal     @db.Decimal(10, 2)
  marginAmount Decimal     @db.Decimal(10, 2)
  marginPercent Float

  items        Json
  inclusions   String[]
  exclusions   String[]
  validUntil   DateTime
  acceptedAt   DateTime?
  notes        String?     @db.Text
  createdAt    DateTime    @default(now())

  lead         Lead        @relation(fields: [leadId], references: [id])
  createdBy    User        @relation(fields: [createdById], references: [id])
  booking      Booking?
}

enum BookingStatus {
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER_NEFT_IMPS
  UPI
  CREDIT_DEBIT_OFFLINE
  CASH
}

enum PaymentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Booking {
  id          String        @id @default(uuid())
  bookingRef  String        @unique
  leadId      String        @unique
  quotationId String        @unique
  status      BookingStatus @default(CONFIRMED)
  totalAmount Decimal       @db.Decimal(10, 2)
  paidAmount  Decimal       @default(0) @db.Decimal(10, 2)
  dueAmount   Decimal       @db.Decimal(10, 2)
  travelDate  DateTime
  createdAt   DateTime      @default(now())

  lead        Lead          @relation(fields: [leadId], references: [id])
  quotation   Quotation     @relation(fields: [quotationId], references: [id])
  payments    Payment[]
}

model Payment {
  id             String                    @id @default(uuid())
  bookingId      String
  recordedById   String
  amount         Decimal                   @db.Decimal(10, 2)
  method         PaymentMethod
  transactionRef String
  receiptFileKey String
  status         PaymentVerificationStatus @default(PENDING)
  notes          String?
  paymentDate    DateTime                  @default(now())
  createdAt      DateTime                  @default(now())

  booking        Booking                   @relation(fields: [bookingId], references: [id])
  recordedBy     User                      @relation(fields: [recordedById], references: [id])
}

// Refresh secrets are never stored in plaintext. Absolute expiry is not extended.
model AuthSession {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String
  refreshTokenHash String   @db.Char(64)
  expiresAt        DateTime @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  lastUsedAt       DateTime @default(now()) @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, revokedAt, expiresAt])
}
